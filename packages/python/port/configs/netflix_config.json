    {
      "id": "netflix_viewing_activity",
      "title": {
        "en": "What you watched",
        "nl": "Wat je hebt gekeken"
      },
      "description": {
        "en": "What you watched on Netflix, when, and for how long, from ViewingActivity.csv.",
        "nl": "Wat je op Netflix hebt gekeken, wanneer en hoe lang, uit ViewingActivity.csv."
      },
      "headers": {
        "Start Time": {
          "en": "Start time",
          "nl": "Starttijd"
        },
        "Duration": {
          "en": "Hours watched",
          "nl": "Aantal uur gekeken"
        },
        "Title": {
          "en": "Title",
          "nl": "Titel"
        },
        "Supplemental Video Type": {
          "en": "Type",
          "nl": "Aanvullende informatie"
        }
      },
      "visualizations": [
        {
          "title": {
            "en": "Your viewing at a glance",
            "nl": "Je kijkgedrag in het kort"
          },
          "type": "stats",
          "tiles": [
            {
              "label": {
                "en": "Viewing sessions",
                "nl": "Kijksessies"
              },
              "aggregate": "count"
            },
            {
              "label": {
                "en": "First watched",
                "nl": "Voor het eerst gekeken"
              },
              "aggregate": "first_date",
              "column": "Start Time"
            },
            {
              "label": {
                "en": "Last watched",
                "nl": "Voor het laatst gekeken"
              },
              "aggregate": "last_date",
              "column": "Start Time"
            },
            {
              "label": {
                "en": "Busiest day",
                "nl": "Drukste dag"
              },
              "aggregate": "busiest_day",
              "column": "Start Time"
            }
          ]
        },
        {
          "title": {
            "en": "Total hours watched per month",
            "nl": "Totaal aantal uren gekeken per maand"
          },
          "type": "area",
          "group": {
            "column": "Start Time",
            "dateFormat": "month",
            "label": "Month"
          },
          "values": [
            {
              "column": "Duration",
              "aggregate": "sum"
            }
          ]
        },
        {
          "title": {
            "en": "Total hours watched by hour of the day",
            "nl": "Totaal aantal uur gekeken per uur van de dag"
          },
          "type": "bar",
          "group": {
            "column": "Start Time",
            "dateFormat": "hour_cycle"
          },
          "values": [
            {
              "column": "Duration",
              "aggregate": "sum"
            }
          ]
        },
        {
          "title": {
            "en": "Titles you watched again and again",
            "nl": "Titels die je steeds opnieuw hebt bekeken"
          },
          "type": "wordcloud",
          "textColumn": "Title",
          "valueColumn": "Duration",
          "tokenize": false
        },
        {
          "title": {
            "en": "Total hours watched by day of the week",
            "nl": "Totaal aantal uur gekeken per dag van de week"
          },
          "type": "bar",
          "group": {
            "column": "Start Time",
            "dateFormat": "weekday_cycle",
            "label": {
              "en": "Day of the week",
              "nl": "Dag van de week"
            }
          },
          "values": [
            {
              "column": "Duration",
              "aggregate": "sum",
              "label": {
                "en": "Hours watched",
                "nl": "Aantal uur"
              }
            }
          ]
        }
      ],
      "extractor": "viewing_activity_to_df",
      "documentation": {
        "summary": "Each row represents one viewing session on Netflix, including the title watched, start time, and duration in hours.",
        "source_file": "ViewingActivity.csv",
        "columns": {
          "Start Time": "ISO 8601 timestamp of when the viewing session started.",
          "Duration": "Duration of the viewing session in hours.",
          "Title": "Name of the Netflix title watched.",
          "Supplemental Video Type": "Type of supplemental video (e.g. trailer), if applicable."
        }
      }
